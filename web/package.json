{
  "name": "localquest",
  "productName": "LocalQuest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"node --env-file-if-exists=.env --watch runner.mjs\" \"vinext dev\"",
    "dev:web": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "tauri:web:dev": "vite --config vite.tauri.config.ts --host 127.0.0.1 --port 1420",
    "tauri:web:build": "vite build --config vite.tauri.config.ts",
    "prepare:tauri": "node scripts/prepare-tauri-runtime.mjs",
    "tauri:dev": "npm run prepare:tauri && tauri dev",
    "tauri:build": "npm run prepare:tauri && tauri build",
    "desktop:dev": "npm run tauri:dev",
    "desktop:pack": "npm run tauri:build -- --no-bundle",
    "desktop:dist": "npm run tauri:build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-tauri --ignore-pattern .next --ignore-pattern src-tauri/target --ignore-pattern src-tauri/runtime --ignore-pattern desktop"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@monaco-editor/react": "^4.7.0",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "vinext": "^1.0.0-beta.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
